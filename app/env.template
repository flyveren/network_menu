OPENAI_API_KEY=sk-your-openai-key
# Optional overrides
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_LANGUAGE=en
# OPENAI_RESPONSE_MODEL=gpt-4o-mini
# OPENAI_RESPONSE_SYSTEM_PROMPT=Du er en hjælpsom assistent, svar kortfattet.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx  # Options: alloy (neutral), echo/fable/onyx (male), nova/shimmer (female). Default: onyx (male, good for Danish)
# OPENAI_TTS_FORMAT=mp3
# OPENAI_TTS_SPEED=1.0
# OPENAI_TTS_PITCH=0
# OPENAI_METADATA_MODEL=gpt-4o-mini
# OPENAI_METADATA_SYSTEM_PROMPT=Du er en neutral dansk tekstanalytiker.

